jni_zero_toolchain = ""

if (jni_zero_toolchain == "") {
  if (is_cobalt && build_with_separate_cobalt_toolchain) {
    # In Cobalt modular builds with separate toolchains, the default
    # toolchain is the Cobalt/Linux toolchain where is_android=false.
    # JNI targets must be evaluated in the starboard toolchain which
    # has current_os="android".
    jni_zero_toolchain = starboard_toolchain
  } else {
    jni_zero_toolchain = default_toolchain
  }
}
